{
  "name": "card-workspace",
  "version": "0.1.14",
  "license": "MIT",
  "description": "Obsidian plugin that shows folder notes as a card stream in the left sidebar.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production",
    "check": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "release:check": "node scripts/check-release.mjs",
    "release:prepare": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:component": "vitest run --project jsdom",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.10.7",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.4",
    "jsdom": "^27.0.1",
    "obsidian": "^1.8.7",
    "oxlint": "^1.63.0",
    "svelte": "^5.55.1",
    "svelte-check": "^4.3.4",
    "typescript": "^5.8.2",
    "typescript-language-server": "^5.1.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  }
}
