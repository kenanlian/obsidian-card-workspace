# Normalize line endings to LF in the repository, check out as-is
* text=auto eol=lf

# Explicitly LF for source files
*.ts    text eol=lf
*.svelte text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
